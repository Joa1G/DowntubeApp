{
  "expo": {
    "name": "downtube-app",
    "slug": "downtube-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/downtube-splash-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icons/downtube-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#a6a6a6"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/downtube-splash-icon.png",
        "backgroundColor": "#a6a6a6"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      }
    },
    "scheme": "meuapp"
  }
}
